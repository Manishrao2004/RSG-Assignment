# Copy to .env. Never commit your real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Recommended fallback model: GROQ_MODEL=openai/gpt-oss-120b
# Chat requires Groq; there is no rule-based fallback.

# Optional: traces contain prompts, SQL, and query results.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rsg-sales-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
